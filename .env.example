# SummAI Production Environment Configuration
# Copy this file to .env.local and populate with your own credentials

# Google Gemini API Key (Strictly Server-Side: NEVER prefix with NEXT_PUBLIC_)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Target (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Base URLs for API calls, canonical meta tags, OpenGraph previews, and sitemap generation
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://summai.vercel.app
